{
    "makefile.configureOnOpen": false,
    "workbench.colorTheme": "Gruvbox Dark Medium",
    "workbench.editor.empty.hint": "hidden",
    "vim.leader": " ",
    "vim.normalModeKeyBindingsNonRecursive": [
    {
        "before": ["y", "y"],
        "after": ["\"", "+", "y", "y"]
    },
    {
      "before": ["d"],
      "after": ["\"","_", "d"]
    },
    {
        "before": ["c"],
        "after": ["\"","_", "c"]
    },
    {
        "before": ["Y"],
        "after": ["\"", "+", "y", "$"]
    },
    {
        "before": ["<leader>", "h"],
        "commands": ["workbench.action.previousEditor"]
    },
    {
        "before": ["<leader>", "l"],
        "commands": ["workbench.action.nextEditor"]
    }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
    {
        "before": ["y"],
        "after": ["\"", "+", "y"]
    },
    {
        "before": ["d"],
        "after": ["\"","_", "d"]
    }
],
"vim.handleKeys": {
    "<C-p>": false
},
"editor.lineNumbers": "relative",
"editor.cursorSurroundingLines": 10,
"chat.agent.enabled": false,
"terminal.integrated.initialHint": false,
"explorer.confirmDragAndDrop": false,
"chat.titleBar.signIn.enabled": false,
"chat.disableAIFeatures": true,
"cmake.environment": {
    "PATH": "c:/Users/thale/.vscode/extensions/stmicroelectronics.stm32cube-ide-build-cmake-1.45.0-win32-x64/resources/cube-cmake/win32/x86_64;c:\\Users\\thale\\.vscode\\extensions\\stmicroelectronics.stm32cube-ide-core-1.3.0-win32-x64\\resources\\binaries\\win32\\x86_64;${env.PATH}"
},
"debug.allowBreakpointsEverywhere": true
}
